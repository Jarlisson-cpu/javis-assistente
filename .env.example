# Copie para .env e preencha com suas chaves reais. Nunca commite o .env.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=

# API web: token de pelo menos 32 caracteres para proteção bearer.
# Para acesso fora do loopback, configure também certificado TLS e chave privada.
JARVIS_WEB_TOKEN=
JARVIS_TLS_CERTFILE=
JARVIS_TLS_KEYFILE=
