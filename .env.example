# Copie para .env e preencha com suas chaves reais. Nunca commite o .env.

# --- IA: preencha UMA delas (o JARVIS detecta sozinho, nesta ordem) ---
# Claude: conversa e executa ações no notebook (recomendado)
ANTHROPIC_API_KEY=
# OpenAI: conversa e executa ações no notebook
OPENAI_API_KEY=
# Gemini: só conversa
GOOGLE_API_KEY=

# Opcional: força provedor/modelo (auto | anthropic | openai | gemini | offline)
JARVIS_AI_PROVIDER=
JARVIS_AI_MODEL=

# Opcional: outro arquivo de configuração (padrão: config.yaml)
JARVIS_CONFIG=

# API web: token de pelo menos 32 caracteres para proteção bearer.
# Para acesso fora do loopback, configure também certificado TLS e chave privada.
JARVIS_WEB_TOKEN=
JARVIS_TLS_CERTFILE=
JARVIS_TLS_KEYFILE=
